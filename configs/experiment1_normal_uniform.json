{
  "scenario_name": "uniform/simple_wood_and_stone",
  "mode": "normal",
  "distribution": "uniform",
  "components": ["Gather", "Build"],
  "world_size": [25, 25],
  "n_agents": 50,
  "n_worlds": 16,
  "episode_length": 300,
  "planner_interval": 25,
  "rollout_steps": 125,
  "updates": 64,
  "learning_rate": 0.005,
  "planner_learning_rate": 0.0005,
  "gamma": 0.99,
  "gae_lambda": 0.95,
  "clip_epsilon": 0.2,
  "value_coefficient": 0.5,
  "entropy_coefficient": 0.01,
  "worker_entropy_coefficient": 0.05,
  "planner_entropy_coefficient": 0.01,
  "normalize_rewards": true,
  "ppo_epochs": 4,
  "minibatch_size": 256,
  "hidden_size": 128,
  "seed": 7,
  "device": "auto",
  "save_weights": true,
  "checkpoint_interval": 10,
  "keep_last_n_checkpoints": 3,
  "log_agent_metrics": true,
  "agent_log_interval": 25,
  "output_dir": "outputs/experiment1_normal_uniform"
}

