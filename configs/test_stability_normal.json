{
  "scenario_name": "uniform/simple_wood_and_stone",
  "mode": "normal",
  "components": ["Gather", "Build"],
  "world_size": [25, 25],
  "n_agents": 50,
  "n_worlds": 2,
  "episode_length": 300,
  "planner_interval": 10,
  "rollout_steps": 30,
  "updates": 6,
  "learning_rate": 0.005,
  "planner_learning_rate": 0.0005,
  "gamma": 0.99,
  "gae_lambda": 0.95,
  "clip_epsilon": 0.2,
  "value_coefficient": 0.5,
  "entropy_coefficient": 0.01,
  "worker_entropy_coefficient": 0.05,
  "planner_entropy_coefficient": 0.01,
  "normalize_rewards": true,
  "ppo_epochs": 2,
  "minibatch_size": 128,
  "hidden_size": 128,
  "seed": 42,
  "device": "auto",
  "save_weights": true,
  "checkpoint_interval": 2,
  "keep_last_n_checkpoints": 2,
  "save_final_weights": true,
  "output_dir": "outputs/stability_normal",
  "checkpoint_path": null
}

